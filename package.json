{
  "name": "old-sea-dogs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/patch-cloudflare-vite-runner.mjs && vinext dev --hostname 0.0.0.0 --port 3000",
    "dev:fixture": "OLDSEADOGS_ENABLE_DEV_HOMEPAGE_FIXTURE=true node scripts/patch-cloudflare-vite-runner.mjs && OLDSEADOGS_ENABLE_DEV_HOMEPAGE_FIXTURE=true vinext dev --hostname 0.0.0.0 --port 3000",
    "build": "vinext build",
    "build:do": "rm -rf dist && node scripts/write-build-info.mjs && OLDSEADOGS_RUNTIME=node vinext build && node scripts/check-digitalocean-build.mjs",
    "typecheck": "tsc --noEmit --pretty false --incremental false",
    "start": "vinext start",
    "start:do": "OLDSEADOGS_RUNTIME=node node --import ./scripts/story-scheduler-hook.mjs ./node_modules/vinext/dist/cli.js start --hostname ${HOST:-127.0.0.1} --port ${PORT:-3000}",
    "check:launch": "node scripts/check-launch-readiness.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "check:stories": "node scripts/check-story-regression.mjs",
    "check:story-media": "node scripts/check-story-media.mjs",
    "check:controlled-media": "node scripts/check-controlled-media.mjs",
    "check:instagram": "node --test tests/instagram-connector.test.mjs",
    "check:instagram-env": "node scripts/check-instagram-env.mjs",
    "check:instagram-routes": "node --test tests/instagram-routes.integration.test.mjs",
    "check:bridge": "node scripts/check-bridge-workflow.mjs",
    "check:bridge-safety": "node --test tests/bridge-safety.integration.test.mjs",
    "check:copyright-publication": "node --test tests/bridge-safety.integration.test.mjs",
    "check:homepage": "node --test tests/bridge-safety.integration.test.mjs tests/homepage-guides-release-safety.test.mjs",
    "check:homepage-story-preservation": "node --test tests/cookie-consent-homepage-preservation.test.mjs",
    "check:guides-release-safety": "node scripts/check-guides-release-safety.mjs",
    "check:guides-package": "node tests/guides-release-package.regression.mjs",
    "check:live-homepage": "node scripts/check-live-homepage-manifest.mjs",
    "check:phase1": "npm run build:do && node --test tests/editor-publication.test.mjs tests/backup-recovery.test.mjs tests/staging-migration.test.mjs tests/bridge-safety.integration.test.mjs tests/staging-rc1.integration.test.mjs && npm run check:storage && npm run check:data && npm run check:story-media && npm run check:bridge && npm run check:controlled-media && npm run check:launch",
    "check:staging-rc1": "node --test tests/staging-migration.test.mjs tests/staging-rc1.integration.test.mjs",
    "staging:fixture": "node scripts/create-staging-rc1-fixture.mjs",
    "check:data": "node scripts/verify-story-data.mjs",
    "reconcile:stories": "node scripts/reconcile-stories.mjs",
    "backup:list": "node scripts/oldseadogs-ops.mjs backup:list",
    "backup:create": "node scripts/oldseadogs-ops.mjs backup:create",
    "backup:stories": "node scripts/oldseadogs-ops.mjs backup:create --label stories",
    "backup:verify": "node scripts/oldseadogs-ops.mjs backup:verify",
    "restore:plan": "node scripts/oldseadogs-ops.mjs restore:plan",
    "restore:apply": "node scripts/oldseadogs-ops.mjs restore:apply",
    "rollback": "node scripts/oldseadogs-ops.mjs rollback",
    "deploy:history": "node scripts/oldseadogs-ops.mjs deploy:history",
    "deploy:safe": "node scripts/oldseadogs-ops.mjs deploy:safe",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern outputs --ignore-pattern .ga4-release-work",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
